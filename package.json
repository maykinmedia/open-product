{
    "name": "Open Product",
    "version": "1.8.0",
    "description": "open-product project",
    "type": "module",
    "main": "src/openproduct/static/bundles/index.js",
    "directories": {
        "doc": "docs"
    },
    "scripts": {
        "build": "node build.js",
        "test": "echo 'no tests defined' && exit 1",
        "watch": "node build.js --watch",
        "collect": "cp node_modules/wysimark-standalone/dist/javascript/index.cjs.js src/openproduct/static/wysimark/wysimark.js && cp node_modules/wysimark-standalone/dist/javascript/index.cjs.js.map src/openproduct/static/wysimark/index.cjs.js.map"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/maykinmedia/open-product.git"
    },
    "author": "Maykin",
    "license": "UNLICENSED",
    "homepage": "https://maykin.nl",
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.1.0",
        "microscope-sass": "latest",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typescript": "latest",
        "wysimark-standalone": "^1.0.0"
    },
    "devDependencies": {
        "esbuild": "latest",
        "esbuild-sass-plugin": "latest",
        "sass-embedded": "latest"
    },
    "overrides": {
        "@portive/client": {
            "axios": "1.19.0"
        }
    }
